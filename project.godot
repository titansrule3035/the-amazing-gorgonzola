; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="The Amazing Gorgonzola"
run/main_scene="uid://cwfwt51iy7wvn"
config/use_custom_user_dir=true
config/custom_user_dir_name="The Amazing Gorgonzola"
config/features=PackedStringArray("4.7", "C#", "Forward Plus")
config/icon="uid://d3h6goqxjmujb"
config/custom_image="uid://drpd6x2gcjpea"

[display]

window/size/viewport_width=1728
window/size/viewport_height=864
window/size/resizable=false
window/size/maximize_disabled=true
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
mouse_cursor/tooltip_position_offset=Vector2(0, 0)
window/hdr_2d=true

[dotnet]

project/assembly_name="The Amazing Gorgonzola"

[editor]

naming/node_name_casing=2
naming/script_name_casing=1

[editor_plugins]

enabled=PackedStringArray("res://addons/GodotInk/plugin.cfg")

[global_group]

editor_placeable=""

[importer_defaults]

font_data_image={
"ascent": 0,
"character_margin": Rect2i(0, 0, 0, 0),
"character_ranges": PackedStringArray("\" \"-\"~\"", "0x20AC", "0xA3", "0xB0", "0x2022", "0x2122", "0x25CE", "0x25C0", "0x25B6", "0x25C1", "0x25B7"),
"columns": 10,
"compress": true,
"descent": 0,
"fallbacks": [],
"image_margin": Rect2i(0, 0, 0, 0),
"kerning_pairs": PackedStringArray(),
"rows": 11,
"scaling_mode": 2
}

