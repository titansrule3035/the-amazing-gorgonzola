config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="The Amazing Gorgonzola"
run/main_scene="uid://rhb6mualyteu"
config/features=PackedStringArray("4.6", "C#", "Forward Plus")
config/icon="uid://d3h6goqxjmujb"
config/custom_image="uid://drpd6x2gcjpea"

[display]

window/size/viewport_width=1248
window/size/viewport_height=832
window/stretch/mode="viewport"
mouse_cursor/custom_image="uid://drpd6x2gcjpea"
mouse_cursor/tooltip_position_offset=Vector2(0, 0)
window/hdr_2d=true

[dotnet]

project/assembly_name="The Amazing Gorgonzola"

[editor]

naming/node_name_casing=2
naming/script_name_casing=1

[editor_plugins]

enabled=PackedStringArray("res://addons/GodotInk/plugin.cfg")

