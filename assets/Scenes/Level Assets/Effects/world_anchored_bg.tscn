[sub_resource type="Shader" id="Shader_dscuk"]
code = "shader_type canvas_item;

uniform sampler2D background_texture : source_color, filter_linear_mipmap, repeat_enable;

// 1.0 = texture's native pixel size, 2.0 = twice as dense.
uniform vec2 texture_scale = vec2(1.0);

// 1.0 = locked to the world, 0.0 = locked to the screen, in between = parallax.
uniform float parallax_factor = 1.0;

// Independent drift in world pixels (wrapped on the C# side).
uniform vec2 scroll_offset = vec2(0.0);

// Logical viewport size (VIEWPORT_SIZE does not exist in canvas_item shaders).
uniform vec2 viewport_size = vec2(1152.0, 648.0);

// Inverse camera/canvas transform: viewport pixels -> world pixels.
uniform vec2 world_from_screen_x = vec2(1.0, 0.0);
uniform vec2 world_from_screen_y = vec2(0.0, 1.0);
uniform vec2 world_from_screen_origin = vec2(0.0);

void fragment() {
    // Viewport position in logical pixels.
    vec2 screen_position = SCREEN_UV * viewport_size;

    // Viewport -> world.
    vec2 world_position =
        world_from_screen_origin
        + world_from_screen_x * screen_position.x
        + world_from_screen_y * screen_position.y;

    // Blend between screen-locked and world-locked, then add independent drift.
    vec2 p = mix(screen_position, world_position, parallax_factor) + scroll_offset;

    // Position -> texture coordinates. repeat_enable handles the tiling.
    vec2 uv = p * texture_scale / vec2(textureSize(background_texture, 0));

    COLOR = texture(background_texture, uv);
}
"

