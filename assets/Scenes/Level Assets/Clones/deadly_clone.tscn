[sub_resource type="Shader" id="Shader_dk3xr"]
code = "shader_type canvas_item;

uniform sampler2D palette_texture; // 1D texture: original colors
uniform sampler2D swap_texture;    // 1D texture: replacement colors
uniform int palette_size = 8;
uniform float threshold = 0.01;

void fragment() {
  vec4 pixel = texture(TEXTURE, UV);
  COLOR = pixel;
  for (int i = 0; i < palette_size; i++) {
    vec2 uv = vec2((float(i) + 0.5) / float(palette_size), 0.5);
    vec4 orig = texture(palette_texture, uv);
    if (length(pixel.rgb - orig.rgb) < threshold) {
      COLOR = vec4(texture(swap_texture, uv).rgb, pixel.a);
      break;
    }
  }
}"

[sub_resource type="ShaderMaterial" id="ShaderMaterial_4udki"]
shader = SubResource("Shader_dk3xr")
shader_parameter/palette_texture = ExtResource("5_tlb6h")
