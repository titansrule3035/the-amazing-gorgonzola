shader = SubResource("Shader_eaw70")
shader_parameter/palette_texture = ExtResource("5_sk63e")
shader_parameter/swap_texture = ExtResource("6_1c534")
shader_parameter/palette_size = 10
shader_parameter/threshold = 0.01

