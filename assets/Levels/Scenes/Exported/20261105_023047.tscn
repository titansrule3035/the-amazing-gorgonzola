[sub_resource type="Shader" id="Shader_huhs0"]
code = "shader_type canvas_item;

uniform bool flip = false;

void fragment() {
    vec2 adjusted_uv = UV;

    if (flip) {
        adjusted_uv.x = 1.0 - adjusted_uv.x;
    }

    COLOR = texture(TEXTURE, adjusted_uv);
}"

[sub_resource type="ShaderMaterial" id="ShaderMaterial_h4t2g"]
shader = SubResource("Shader_huhs0")
shader_parameter/flip = true

[sub_resource type="RectangleShape2D" id="RectangleShape2D_eaw70"]
size = Vector2(22, 53)

[sub_resource type="Shader" id="Shader_eaw70"]
code = "shader_type canvas_item;

uniform sampler2D palette_texture; // 1D texture: original colors
uniform sampler2D swap_texture;    // 1D texture: replacement colors
uniform int palette_size = 8;
uniform float threshold = 0.01;

void fragment() {
  vec4 pixel = texture(TEXTURE, UV);
  COLOR = pixel;
  for (int i = 0; i < palette_size; i++) {
    vec2 uv = vec2((float(i) + 0.5) / float(palette_size), 0.5);
    vec4 orig = texture(palette_texture, uv);
    if (length(pixel.rgb - orig.rgb) < threshold) {
      COLOR = vec4(texture(swap_texture, uv).rgb, pixel.a);
      break;
    }
  }
}"

[sub_resource type="ShaderMaterial" id="ShaderMaterial_x63qt"]
shader = SubResource("Shader_eaw70")
shader_parameter/palette_texture = ExtResource("12_fl5b7")
shader_parameter/swap_texture = ExtResource("13_j0v0w")
shader_parameter/palette_size = 10
shader_parameter/threshold = 0.01

